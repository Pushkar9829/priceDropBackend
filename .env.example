# Server
NODE_ENV=development
PORT=5000
# API processes for `npm start` (one per CPU core by default, max 8). `npm run start:single` = 1 process.
# WEB_CONCURRENCY=2
API_PREFIX=/api/v1

# MongoDB
# MongoDB (local or Atlas)
# MONGODB_URI=mongodb://127.0.0.1:27017/price_comparison
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/price_comparison?retryWrites=true&w=majority

# JWT — production refuses to start unless this is a random string of 32+ characters
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins of the frontend (dev: Vite on 5173)
CORS_ORIGIN=http://localhost:5173

# Set to 1 when running behind one reverse proxy (Render, Heroku, Nginx) so rate limits see real client IPs
TRUST_PROXY=0

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Live price monitor — the cron is a scheduler TICK; each tick checks only listings that are due
PRICE_MONITOR_CRON=*/5 * * * *
ENABLE_CRON=true
# How often a listing is re-checked, by demand tier (minutes)
MONITOR_HOT_INTERVAL_MIN=30        # product has an active alert or is on a watchlist
MONITOR_NORMAL_INTERVAL_MIN=120    # visible product nobody is tracking
MONITOR_COLD_INTERVAL_MIN=720      # product hidden by an admin
MONITOR_MAX_BACKOFF_MIN=1440       # failing listings back off exponentially up to this
MONITOR_BATCH_SIZE=150             # max listings per tick
MONITOR_TICK_BUDGET_SEC=240        # stop picking new work after this, so ticks never overlap
MONITOR_PER_STORE_CONCURRENCY=2    # parallel checks per store (stores run in parallel)
MONITOR_PER_STORE_DELAY_MS=1500    # polite pause between requests to the same store
MONITOR_STALE_ON_VIEW_MIN=30       # opening a product older than this re-queues it
# Secret for POST /api/v1/internal/monitor/tick (external cron when the host sleeps, e.g. Render free)
CRON_SECRET=

# Scraper / Data Collection Engine
# demo = local demo feed (default, safe)
# http = Axios + Cheerio against productUrl (permitted sources only)
# auto = API/feed → demo → http → playwright
SCRAPER_MODE=http
SCRAPER_TIMEOUT_MS=45000
SCRAPER_MAX_RETRIES=2
SCRAPER_CONCURRENCY=3
# Required for live Flipkart (and other JS-rendered storefronts)
SCRAPER_ENABLE_PLAYWRIGHT=true
SCRAPER_FIXTURE_BASE=http://127.0.0.1:5055
SCRAPER_FIXTURE_HOST=127.0.0.1
SCRAPER_FIXTURE_PORT=5055
SCRAPER_USER_AGENT=PriceCompareBot/1.0 (+https://pricecompare.local; permitted-data-collection)

# Amazon Creators API (live amazon.in prices — official affiliate catalog)
# Associates Central → Tools → Creators API → Create Application → Create Credential
# India usually uses credential version 2.2 or 3.2. Partner tag = your Associates tracking ID.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=2.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in

# Flipkart — no affiliate API. Live prices via Playwright HTML scrape when
# SCRAPER_MODE=http and SCRAPER_ENABLE_PLAYWRIGHT=true. Store real flipkart.com
# productUrl values on StoreProduct (seed defaults to fixture URLs for local tests).
# Run: npx playwright install chromium
#      npm run scrape:flipkart -- --url "https://www.flipkart.com/.../p/itm...?pid=..."
#      npm run scrape:flipkart -- --search "iphone 16" --limit 5

# Email (Nodemailer) — leave empty to use console logger in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pricecompare.local

# Push notifications (FCM) — leave empty to use console logger in development
FCM_SERVER_KEY=

# Admin seed (used by seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@pricecompare.local
ADMIN_PASSWORD=Admin@12345
