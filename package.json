    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "playwright": "^1.50.0",
    "slugify": "^1.6.6"
