{
  "name": "price-comparison-backend",
  "version": "1.0.0",
  "description": "Shopping price comparison platform backend (Buyhatke-style)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/cluster.js",
    "dev": "nodemon src/server.js",
